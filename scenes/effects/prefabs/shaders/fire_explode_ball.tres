code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float Deformation_Scale = 1.0;
uniform vec2 Deformation_Speed;
uniform sampler2D Deformation_Texture : filter_nearest;
uniform float Deformation_Intensity;
uniform sampler2D SmokeTexture : filter_nearest;
uniform sampler2D tex_frg_12 : source_color;
uniform sampler2D SmokeDisappearTexture;
uniform vec4 EmissionColor : source_color;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// FloatParameter:14
	float n_out14p0 = Deformation_Scale;


// Input:9
	float n_out9p0 = TIME;


// Vector2Parameter:13
	vec2 n_out13p0 = Deformation_Speed;


// VectorOp:10
	vec2 n_out10p0 = vec2(n_out9p0) * n_out13p0;


// UVFunc:8
	vec2 n_out8p0 = n_out10p0 * vec2(n_out14p0) + UV;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Deformation_Texture, n_out8p0);
	float n_out5p1 = n_out5p0.r;


// FloatParameter:11
	float n_out11p0 = Deformation_Intensity;


// FloatOp:7
	float n_out7p0 = n_out5p1 * n_out11p0;


// Input:3
	vec3 n_out3p0 = NORMAL;


// VectorOp:6
	vec3 n_out6p0 = vec3(n_out7p0) * n_out3p0;


// VectorOp:4
	vec3 n_out4p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(SmokeTexture, UV);


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, vec2(n_out3p0.xy));


// Input:18
	vec4 n_out18p0 = COLOR;
	float n_out18p4 = n_out18p0.a;


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(SmokeDisappearTexture, UV);
	float n_out15p1 = n_out15p0.r;


// SmoothStep:16
	float n_in16p1 = 1.00000;
	float n_out16p0 = smoothstep(n_out18p4, n_in16p1, n_out15p1);


// ColorParameter:13
	vec4 n_out13p0 = EmissionColor;


// FloatConstant:5
	float n_out5p0 = 20.000000;


// VectorOp:6
	vec3 n_out6p0 = vec3(n_out13p0.xyz) * vec3(n_out5p0);


// UVFunc:20
	vec2 n_in20p1 = vec2(0.20000, 0.20000);
	vec2 n_in20p2 = vec2(0.00000, 0.00000);
	vec2 n_out20p0 = n_in20p2 * n_in20p1 + UV;


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(SmokeTexture, n_out20p0);
	float n_out7p1 = n_out7p0.r;


// Input:19
	vec4 n_out19p0 = COLOR;


// SmoothStep:9
	float n_in9p2 = 1.00000;
	float n_out9p0 = smoothstep(n_out7p1, n_out19p0.x, n_in9p2);


// VectorOp:8
	vec3 n_out8p0 = n_out6p0 * vec3(n_out9p0);


// Output:0
	ALBEDO = vec3(n_out12p0.xyz);
	ALPHA = n_out16p0;
	EMISSION = n_out8p0;


}
