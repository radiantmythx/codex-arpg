code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D tex_vtx_5 : source_color;
uniform float Deformation_Intensity;
uniform vec4 ColorParameter : source_color;
uniform vec2 PolarCoordsXY;
uniform sampler2D AuraTexture;
uniform sampler2D tex_frg_9 : source_color;



void vertex() {
// Input:3
	vec3 n_out3p0 = VERTEX;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_vtx_5, UV);
	float n_out5p1 = n_out5p0.r;


// FloatParameter:8
	float n_out8p0 = Deformation_Intensity;


// FloatOp:7
	float n_out7p0 = n_out5p1 * n_out8p0;


// Input:9
	vec3 n_out9p0 = NORMAL;


// VectorOp:6
	vec3 n_out6p0 = vec3(n_out7p0) * n_out9p0;


// VectorOp:4
	vec3 n_out4p0 = n_out3p0 + n_out6p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// ColorParameter:12
	vec4 n_out12p0 = ColorParameter;


	vec2 n_out4p0;
// UVPolarCoord:4
	vec2 n_in4p1 = vec2(0.50000, 0.50000);
	float n_in4p2 = 1.00000;
	float n_in4p3 = 1.00000;
	{
		vec2 __dir = UV - n_in4p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out4p0 = vec2(__radius * n_in4p2, __angle * n_in4p3);
	}


// Vector2Parameter:7
	vec2 n_out7p0 = PolarCoordsXY;


// Input:6
	float n_out6p0 = TIME;


// VectorOp:8
	vec2 n_out8p0 = n_out7p0 * vec2(n_out6p0);


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out8p0 * n_in5p1 + n_out4p0;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(AuraTexture, n_out5p0);


// VectorOp:11
	vec4 n_out11p0 = n_out12p0 * n_out2p0;


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, UV);


// Output:0
	ALBEDO = vec3(n_out11p0.xyz);
	ALPHA = n_out9p0.x;


}
"
