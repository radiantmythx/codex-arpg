[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform float Auraintensity;
uniform vec4 AuraColor : source_color;
uniform vec2 AuraScale = vec2(1.000000, 1.000000);
uniform vec2 AuraSpeed;
uniform sampler2D AuraShape : source_color;



void fragment() {
// FloatParameter:5
	float n_out5p0 = Auraintensity;


// ColorParameter:4
	vec4 n_out4p0 = AuraColor;


// VectorOp:6
	vec4 n_out6p0 = vec4(n_out5p0) * n_out4p0;


// Vector2Parameter:11
	vec2 n_out11p0 = AuraScale;


// Vector2Parameter:8
	vec2 n_out8p0 = AuraSpeed;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:10
	vec2 n_out10p0 = n_out8p0 * vec2(n_out9p0);


// UVFunc:7
	vec2 n_out7p0 = n_out10p0 * n_out11p0 + UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(AuraShape, n_out7p0);
	float n_out3p1 = n_out3p0.r;


// Output:0
	ALBEDO = vec3(n_out6p0.xyz);
	ALPHA = n_out3p1;


}
"
