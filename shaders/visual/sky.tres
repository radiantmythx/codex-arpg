code = "shader_type sky;
uniform float FloatParameter = 3.0;
uniform sampler2D SkyTexture : source_color, filter_nearest;
uniform vec3 RGB_Intensity = vec3(1.000000, 1.000000, 1.000000);



void sky() {
// Input:5
	vec2 n_out5p0 = SKY_COORDS;


// FloatParameter:9
	float n_out9p0 = FloatParameter;


// UVFunc:8
	vec2 n_in8p2 = vec2(0.00000, 0.00000);
	vec2 n_out8p0 = (n_out5p0 - n_in8p2) * vec2(n_out9p0) + n_in8p2;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(SkyTexture, n_out8p0);


// Vector3Parameter:7
	vec3 n_out7p0 = RGB_Intensity;


// VectorOp:6
	vec4 n_out6p0 = n_out4p0 * vec4(n_out7p0, 0.0);


// Output:0
	COLOR = vec3(n_out6p0.xyz);


}
"
