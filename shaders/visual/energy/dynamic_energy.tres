code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 Energy_Color : source_color;
uniform vec2 Vector2Parameter;
uniform sampler2D Texture2DParameter : filter_nearest;
uniform float EnergyPower;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = Energy_Color;


// Vector2Parameter:7
	vec2 n_out7p0 = Vector2Parameter;


// Input:8
	float n_out8p0 = TIME;


// VectorOp:9
	vec2 n_out9p0 = n_out7p0 * vec2(n_out8p0);


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out9p0 * n_in6p1 + UV;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(Texture2DParameter, n_out6p0);


// VectorDecompose:5
	float n_out5p0 = n_out4p0.x;
	float n_out5p1 = n_out4p0.y;
	float n_out5p2 = n_out4p0.z;
	float n_out5p3 = n_out4p0.w;


// FloatParameter:11
	float n_out11p0 = EnergyPower;


// FloatOp:10
	float n_out10p0 = n_out5p0 * n_out11p0;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out10p0;


}
"
